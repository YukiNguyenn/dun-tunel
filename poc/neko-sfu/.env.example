# Copy to .env and fill in before running `docker compose up -d`.

# Public IP that Neko + viewer use to reach the SFU.
# - Localhost spike: 127.0.0.1
# - LAN viewers: machine LAN IP (e.g. 192.168.1.50)
# - Remote viewers: server public IP
SFU_PUBLIC_IP=127.0.0.1

# TURN shared secret used by mediasoup TURN listener.
# Random 32+ byte secret in real deploys; PoC uses fixed string.
TURN_SHARED_SECRET=poc-turn-secret
