[Unit]
Description=Caddy reverse proxy (dun-tunel edge)
Documentation=https://caddyserver.com/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
EnvironmentFile=/etc/dun-tunel/caddy.env
# Caddyfile is generated from Caddyfile.tpl by deploy/scripts/bootstrap.sh
# (REGION_ID substitution + DNS-01 token plumbing).
ExecStart=/usr/bin/caddy run --environ --config /etc/caddy/Caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/caddy/Caddyfile --force
TimeoutStopSec=5s
LimitNOFILE=1048576
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Caddy admin API listens on localhost:2019 — never expose externally.

[Install]
WantedBy=multi-user.target
