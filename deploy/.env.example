# Edge_Server stack — copy to `.env` và điền giá trị thật.
# Phase 1 single-VPS layout (dun-api + edge-control + Caddy +
# rathole cùng VPS). Multi-region (Phase 3) split files này theo
# region.

# ─── Topology ────────────────────────────────────────────────
# Region key. Phải khớp ShareRegion enum bên dun-api.
REGION_ID=sin

# Domain gốc — dùng cho viewer wildcard (*.sin.dun-studio.xyz),
# admin endpoint (edge.sin.dun-studio.xyz), rathole control
# (tunnel.sin.dun-studio.xyz). Cloudflare DNS set DNS-only
# (xám), tất cả 3 hostname trỏ cùng VPS IP.
SHARE_TUNNEL_DOMAIN=dun-studio.xyz

# ─── Public ports (firewall mở) ──────────────────────────────
# 8443/tcp  — Caddy entry point (HTTPS chung cho dun-api +
#             edge-control + viewer). Provider không mở 443
#             nên dùng 8443; URL viewer kèm `:8443` suffix.
# 2333/tcp  — rathole control channel (dun-app rathole client
#             connect vào để mở reverse tunnel).
# 50000-60000/udp — mediasoup ICE port range cho viewer
#             subscribe stream.
CADDY_PUBLIC_PORT=8443
RATHOLE_PUBLIC_PORT=2333
MEDIASOUP_RTC_MIN_PORT=50000
MEDIASOUP_RTC_MAX_PORT=60000

# ─── SFU media (Phase 2 direct-UDP) ──────────────────────────
# Edge PUBLIC IPv4 that mediasoup advertises in ICE candidates and
# that the owner's Neko udpsink targets. MUST be the public address,
# NOT the private NAT IP (if the VPS sits behind 1:1 NAT, this is the
# routable public IP, e.g. 58.187.17.128). Required.
SFU_ANNOUNCED_IP=
# Bind on all interfaces inside the VPS network namespace.
SFU_LISTEN_IP=0.0.0.0
# Optional LAN candidate for same-network (hairpin) testing. When the
# owner/viewer shares the same public IP as this VPS (same LAN / same NAT
# pool), set this to the edge's LAN-private IPv4 (e.g. 192.168.20.6). The
# SFU then advertises it as an extra ICE host candidate so a same-LAN
# viewer connects directly instead of hairpinning off SFU_ANNOUNCED_IP.
# Pair with DUN_SFU_MEDIA_HOST_OVERRIDE on the owner (dun-app) side so the
# Neko udpsink ingest leg also uses the private IP. Leave EMPTY in
# production — real viewers have distinct public IPs.
#
# NOTE: when set, the SFU advertises the LAN candidate on a SEPARATE UDP
# mux port = (SFU_RTC_MIN_PORT + worker_index + 1000), e.g. 51100 for a
# single worker. mediasoup binds one socket per ICE candidate, so the LAN
# candidate cannot share the public mux port. Make sure that LAN mux port
# (51100 by default) is reachable on the edge's LAN interface — no
# port-forward needed (same-LAN viewer hits the private IP directly), but
# the edge host firewall must accept UDP on it.
SFU_ANNOUNCED_IP_LAN=
# Producer-ingest pool (owner Neko udpsink → mediasoup PlainTransport,
# comedia mode). Must sit inside the provider-forwarded UDP range.
SFU_PLAIN_RTP_MIN_PORT=50000
SFU_PLAIN_RTP_MAX_PORT=50099
# Viewer WebRtcTransport pool (mediasoup → browsers). PoC found a wide
# random range hit a provider port-mapping quirk; keep this inside the
# verified-forwarded band. ~5000 ports ≈ 2500 concurrent viewers.
SFU_RTC_MIN_PORT=50100
SFU_RTC_MAX_PORT=59999

# ─── Internal upstreams (loopback only) ──────────────────────
# Caddy demux 8443 theo Host header sang các service nội bộ:
#   api.dun-studio.xyz       → 127.0.0.1:3000   (dun-api)
#   edge.sin.dun-studio.xyz  → 127.0.0.1:9443   (edge-control)
#   *.sin.dun-studio.xyz     → dynamic routes (rathole upstream)
DUN_API_LOCAL_PORT=3000
EDGE_CONTROL_LOCAL_PORT=9443

# ─── dun-api ↔ edge-control ──────────────────────────────────
# Edge_Server stack chạy network_mode: host (bắt buộc cho mediasoup
# UDP performance). Gọi dun-api qua localhost của host — port
# ${APP_PORT} đã expose từ docker-compose của dun-api (ports map).
# Mặc định APP_PORT=3010; sửa nếu .env dun-api dùng port khác.
DUN_API_ENDPOINT=http://localhost:3010
# Match `EDGE_CALLBACK_API_KEY` của dun-api. Cùng key cho:
#  - Edge → dun-api callback (X-Edge-Api-Key header)
#  - dun-api → Edge admin (provisionTunnel/cleanupTunnel)
#  - Edge revocation lookup HTTP oracle
# Tối thiểu 24 chars. Sinh: `openssl rand -base64 32`
DUN_API_KEY=REPLACE_WITH_RANDOM_24CHARS_MIN

# ─── Cloudflare DNS-01 challenge (Caddy auto-renew) ─────────
# Token scope: DNS:Edit cho zone `dun-studio.xyz` ONLY.
# Caddy issue wildcard cert *.<region>.<domain> + edge.<region>.<domain>.
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CF_API_TOKEN

# ─── JWT verification (R6.4, 5b.7) ──────────────────────────
# Phải khớp `TUNNEL_JWT_KEYS` bên dun-api theo từng kid.
# Lấy phần BASE64-SECRET sau "kid:" của dun-api, KHÔNG bao gồm
# prefix "v1:". Mỗi secret ≥ 32 raw bytes.
# Sinh đồng bộ với dun-api: `openssl rand -base64 48`
TUNNEL_JWT_SECRET_V1=REPLACE_WITH_BASE64_48BYTES_SECRET
# v2 chỉ điền khi đang rotate keyring (xem runbook
# dun-api/docs/runbooks/jwt-rotation.md). Empty là OK.
TUNNEL_JWT_SECRET_V2=

# ─── Persistent state ────────────────────────────────────────
# Sequence counter cho bandwidth reporter (R3.5 restart safety).
# Bind mount qua docker-compose volume.
PERSISTENT_QUEUE_DIR=/var/lib/dun-tunel/queue

# ─── rathole config ──────────────────────────────────────────
# Path tới rendered TOML (từ rathole.tpl.toml). Edge bridge
# rewrite file này khi register/deregister service.
RATHOLE_CONFIG_PATH=/etc/rathole/server.toml
# ĐỪNG set RATHOLE_PID_FILE với rathole upstream (rapiz1/rathole):
# binary KHÔNG bắt SIGHUP nên tín hiệu này GIẾT CẢ server → mọi tunnel
# đang sống rớt sạch mỗi lần bridge rewrite config (register/deregister/
# token rotate). Để trống — rathole tự hot-reload bằng file-watch, chỉ
# đụng đúng service thay đổi. Chỉ set RATHOLE_RELOAD_CMD nếu bạn chắc
# build rathole của mình xử lý được reload.
# RATHOLE_PID_FILE=/var/run/rathole.pid

# ─── Caddy admin ─────────────────────────────────────────────
# Loopback only, edge-caddy-bridge PATCH/DELETE qua đây.
CADDY_ADMIN_URL=http://127.0.0.1:2019

# ─── Viewer cookie auth gate (Option E', EdDSA) ──────────────
# `edge-viewer-gate` sidecar verifies the EdDSA `dun_v` cookie
# stateless qua JWKS pulled from dun-api. Caddy `forward_auth` →
# 127.0.0.1:9444/check trên mỗi request không phải public asset.
#
# Bind address: chỉ loopback. Caddy là caller duy nhất.
EDGE_VIEWER_GATE_UPSTREAM=127.0.0.1:9444

# JWKS endpoint trên dun-api. Phải reachable từ host network của
# Edge_Server VPS. Dùng public api.<domain> nếu dun-api ở VPS
# khác; loopback nếu cùng host (Phase 1 default).
VIEWER_GATE_JWKS_URL=http://localhost:3010/api/viewer/jwks
# Refresh interval cho JWKS document (giây). Default 24h —
# rotation kid gradual (overlap kid window) nên không cần poll
# thường xuyên.
VIEWER_GATE_JWKS_REFRESH_SECONDS=86400

# Revocation list endpoint (optional). Khi set, sidecar poll
# danh sách jti đã revoke qua HTTP, mirror vào RAM. Không set
# = chỉ verify signature, jti revocation chỉ effective sau khi
# cookie hết TTL (mặc định 10 phút).
VIEWER_GATE_REVOCATION_URL=http://localhost:3010/api/tunnels/revoked-jtis
VIEWER_GATE_REVOCATION_POLL_SECONDS=5

# Strict mode (P0 hardening). Khi `true`, sidecar reject MỌI cookie
# nếu danh sách revocation đã quá hạn (max staleness). Trade-off:
# instant revocation thắng availability — dun-api outage sẽ visible
# với viewer (503 thay vì cho qua bằng signature đã có). Dùng khi
# hệ thống có ngưỡng force-revoke nhanh (bandwidth cap, abuse
# detection): cookie bị leak không thể sống quá vài giây sau revoke.
# Default `false` cho dev / closed-beta.
VIEWER_GATE_REVOCATION_REQUIRED=false
# Ngưỡng "stale" (giây). Lần poll thành công cuối cùng cách nay
# quá ngưỡng này → strict mode bắt đầu reject. Đặt = 6× poll
# interval để tolerant với hiccup ngắn.
VIEWER_GATE_REVOCATION_MAX_STALENESS_SECONDS=30

# ─── Logging ─────────────────────────────────────────────────
RUST_LOG=info,edge_control=debug,edge_sfu=debug
